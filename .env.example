# ==============================================================================
# Vaultix AI Questionnaire Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
DATABASE_URL="postgres://user:password@localhost:5432/ai_questionnaire?sslmode=prefer"
PGSSL_NO_VERIFY="false"
PG_POOL_MAX="10"

# ------------------------------------------------------------------------------
# 2. Application URLs & Internal Service Routing
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
BACKEND_INTERNAL_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# 3. Authentication (Better-Auth & Google OAuth)
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-a-secure-random-32-char-string"
BETTER_AUTH_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-secure-jwt-secret-key"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. AI & LLM Provider (NVIDIA Nemotron)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
EMBEDDING_DIMENSIONS="768"

# ------------------------------------------------------------------------------
# 5. Background Queue & Cache (Redis & BullMQ)
# ------------------------------------------------------------------------------
REDIS_DISABLED="false"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 6. Email Service (SMTP / Nodemailer / Resend)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Vaultix <noreply@vaultix.io>"
RESEND_API_KEY=""

# ------------------------------------------------------------------------------
# 7. Payments & Billing (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
