generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

generator clientRoot {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}

// ─── Users & Workspaces ───

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Custom fields
  company       String?
  avatarUrl     String?   @map("avatar_url") // Keep for legacy/custom use if needed

  sessions      Session[]
  accounts      Account[]
  memberships   WorkspaceMember[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@map("verifications")
}

// Tracks free-trial signups by device + network so the same device
// or IP can't claim multiple free trials.
model TrialClaim {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  email           String
  ipHash          String   @map("ip_hash")
  fingerprintHash String?  @map("fingerprint_hash")
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([ipHash])
  @@index([fingerprintHash])
  @@map("trial_claims")
}

model Workspace {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  plan                PlanTier             @default(FREE)
  exportCredits       Int                  @default(0) @map("export_credits")
  polarCustomerId     String?              @unique @map("polar_customer_id")
  polarSubscriptionId String?              @unique @map("polar_subscription_id")
  subscriptionStatus  String?              @map("subscription_status")
  currentPeriodEnd    DateTime?            @map("current_period_end")
  trialEndsAt         DateTime?            @map("trial_ends_at")
  stripeCustomerId    String?              @map("stripe_customer_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  members             WorkspaceMember[]
  documents           Document[]
  questionnaires      Questionnaire[]
  auditLogs           AuditLog[]
  knowledgeVaultItems KnowledgeVaultItem[]
  billingOrders       BillingOrder[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  role        Role     @default(EDITOR)
  joinedAt    DateTime @default(now()) @map("joined_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

// ─── Knowledge Base ───

model Document {
  id             String   @id @default(cuid())
  fileName       String   @map("file_name")
  fileType       String   @map("file_type")
  fileSize       Int      @map("file_size")
  storagePath    String?  @map("storage_path")
  status         DocumentStatus @default(PROCESSING)
  pageCount      Int?     @map("page_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspaceId    String   @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  chunks         DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id             String   @id @default(cuid())
  content        String
  pageNumber     Int?     @map("page_number")
  chunkIndex     Int      @map("chunk_index")
  tokenCount     Int?     @map("token_count")
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime @default(now()) @map("created_at")

  documentId     String   @map("document_id")
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

// ─── Questionnaires ───

model Questionnaire {
  id             String              @id @default(cuid())
  name           String
  fileName       String              @map("file_name")
  fileType       String              @map("file_type")
  status         QuestionnaireStatus @default(PROCESSING)
  totalQuestions Int                 @default(0) @map("total_questions")
  answeredCount  Int                 @default(0) @map("answered_count")
  approvedCount  Int                 @default(0) @map("approved_count")
  isUnlocked     Boolean             @default(false) @map("is_unlocked")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  workspaceId    String              @map("workspace_id")
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  questions      Question[]
  billingOrders  BillingOrder[]

  @@map("questionnaires")
}

model BillingOrder {
  id              String        @id @default(cuid())
  workspaceId     String        @map("workspace_id")
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  questionnaireId String?       @map("questionnaire_id")
  questionnaire   Questionnaire? @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)
  polarCheckoutId String        @unique @map("polar_checkout_id")
  polarOrderId    String?       @unique @map("polar_order_id")
  purchaseType    PurchaseType  @map("purchase_type")
  amountCents     Int           @map("amount_cents")
  currency        String        @default("usd")
  status          OrderStatus   @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([questionnaireId])
  @@map("billing_orders")
}

model Question {
  id             String   @id @default(cuid())
  questionText   String   @map("question_text")
  answerText     String?  @map("answer_text")
  confidence     Float?
  status         AnswerStatus @default(DRAFT)
  rowIndex       Int      @map("row_index")
  auditorCritique String? @map("auditor_critique")
  verifiedFromVault Boolean @default(false) @map("verified_from_vault")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  questionnaireId String  @map("questionnaire_id")
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  citations      Citation[]

  @@map("questions")
}

model Citation {
  id             String   @id @default(cuid())
  sourceDocument String   @map("source_document")
  pageNumber     Int?     @map("page_number")
  excerpt        String?

  questionId     String   @map("question_id")
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("citations")
}

model KnowledgeVaultItem {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  questionText   String   @map("question_text")
  answerText     String   @map("answer_text")
  status         String   @default("HUMAN_VERIFIED")
  lastVerifiedAt DateTime @default(now()) @map("last_verified_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("knowledge_vault_items")
}

// ─── Audit Log ───

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  details     Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String   @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

// ─── Newsletter ───

model NewsletterSubscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  source     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

// ─── Enums ───

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum PlanTier {
  FREE
  PRO
}

enum Plan {
  TRIAL
  STARTER
  PRO
  ENTERPRISE
}

enum PurchaseType {
  SINGLE_PASS
  PRO_SUBSCRIPTION
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum QuestionnaireStatus {
  PROCESSING
  GENERATING
  REVIEW
  COMPLETED
}

enum AnswerStatus {
  DRAFT
  REVIEW
  APPROVED
}
