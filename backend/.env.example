# ==============================================================================
# Vaultix Backend Environment Template (backend/.env.example)
# Copy this file to backend/.env
# ==============================================================================

# PostgreSQL Database (with pgvector)
DATABASE_URL="postgres://user:password@localhost:5432/ai_questionnaire?sslmode=prefer"
PGSSL_NO_VERIFY="false"
PG_POOL_MAX="10"

# Backend Server & Routing
PORT=4000
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Authentication & Session Secrets
BETTER_AUTH_SECRET="your-better-auth-secret-key-32-chars-min"
BETTER_AUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-signing-secret"

# NVIDIA AI Engine (Nemotron)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
EMBEDDING_DIMENSIONS="768"

# Redis & BullMQ Job Queue
REDIS_DISABLED="false"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"

# Email Delivery (SMTP / Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Vaultix <noreply@vaultix.io>"

# Stripe Integration
STRIPE_SECRET_KEY=""
