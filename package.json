{
  "name": "ai-qouestionoier",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c cyan,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:redis": "redis-server --port 6379 --bind 127.0.0.1 --save \"\" --appendonly no --loglevel warning",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "next dev -p 3000 -H 0.0.0.0",
    "build": "prisma generate --schema=./backend/prisma/schema.prisma && next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "postinstall": "prisma generate --schema=./backend/prisma/schema.prisma || true"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@tailwindcss/postcss": "^4",
    "axios": "^1.15.1",
    "better-auth": "^1.6.5",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "nodemailer": "^9.0.3",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "sonner": "^2.0.7",
    "stripe": "^22.0.2",
    "tailwindcss": "^4",
    "use-debounce": "^10.1.1",
    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
